{
  "name": "dars-jadval",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Maktab dars jadvalini avtomatlashtirish tizimi",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "bench": "esbuild scripts/bench.ts --bundle --platform=node --format=esm --outfile=scripts/.bench.mjs --log-level=warning && node scripts/.bench.mjs",
    "bench:inc": "esbuild scripts/bench-incremental.ts --bundle --platform=node --format=esm --outfile=scripts/.bench-inc.mjs --log-level=warning && node scripts/.bench-inc.mjs",
    "bench:cat": "esbuild scripts/bench-category.ts --bundle --platform=node --format=esm --outfile=scripts/.bench-cat.mjs --log-level=warning && node scripts/.bench-cat.mjs",
    "bench:seeds": "esbuild scripts/bench-seeds.ts --bundle --platform=node --format=esm --outfile=scripts/.bench-seeds.mjs --log-level=warning && node scripts/.bench-seeds.mjs",
    "bench:excel": "esbuild scripts/bench-excel.ts --bundle --platform=node --format=esm --external:xlsx --outfile=scripts/.bench-excel.mjs --log-level=warning && node scripts/.bench-excel.mjs",
    "bench:site": "esbuild scripts/bench-site.ts --bundle --platform=node --format=esm --outfile=scripts/.bench-site.mjs --log-level=warning && node scripts/.bench-site.mjs",
    "smoke": "node scripts/run-smoke.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
